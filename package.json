{
  "name": "web-dataroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "npm run build:react && npm run build:public",
    "build:react": "tsc -b && vite build --outDir dist-react",
    "build:public": "astro build --root astro",
    "optimize:dataroom-media": "node scripts/optimize-dataroom-media.mjs",
    "optimize:large-images": "node scripts/optimize-large-images.mjs",
    "preview": "vite preview --port 4174",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:offline": "node e2e/offline.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "dexie": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.4",
    "xlsx": "^0.18.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.0",
    "astro": "^7.2.4",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@rollup/plugin-terser": "^1.0.0",
    "serialize-javascript": "^7.0.4"
  }
}
