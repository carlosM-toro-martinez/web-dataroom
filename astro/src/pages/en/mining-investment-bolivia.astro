---
import MainLayout from "../../layouts/MainLayout.astro";
import PublicShell from "../../layouts/PublicShell.astro";
import hero from "../../assets/lipena-cobre.jpg";
---

<MainLayout
  title="Mining Investment in Bolivia | Gold Copper Silver | Minera Marte"
  description="Mining investment review in Bolivia with Minera Marte S.R.L., focused on gold, copper, silver, Potosi and Sud Lipez exploration opportunities."
  canonicalPath="/en/mining-investment-bolivia"
  keywords="mining investment Bolivia, Bolivia mining project, gold copper silver Bolivia, Potosi mining investment, Sud Lipez mining"
>
  <PublicShell>
    <main>
      <section class="topic-hero">
        <img src={hero.src} alt="Mining investment review for copper gold silver Bolivia" />
        <div class="container topic-content">
          <p class="eyebrow">Mining Investment Bolivia</p>
          <h1>Gold, Copper and Silver Exploration Review</h1>
          <p class="hero-copy">Minera Marte provides controlled Data Room access for qualified review of technical and corporate mining information in Bolivia.</p>
          <div class="hero-actions"><a class="button gold" href="/solicitar-acceso-data-room">Request Data Room Access</a></div>
        </div>
      </section>
      <section class="section"><div class="container grid three">
        <article class="card"><h3>Strategic Metals</h3><p>Gold, copper and silver exploration focus in southern Bolivia.</p></article>
        <article class="card"><h3>Potosi Region</h3><p>Historic mining setting with modern technical review needs.</p></article>
        <article class="card"><h3>Controlled Access</h3><p>Temporary visitor credentials for Data Room evaluation.</p></article>
      </div></section>
    </main>
  </PublicShell>
</MainLayout>
