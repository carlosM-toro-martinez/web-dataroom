---
import MainLayout from "../layouts/MainLayout.astro";
import PublicShell from "../layouts/PublicShell.astro";
import campamento from "../assets/campamento-la-lipena.jpeg";
import bocamina from "../assets/nueva-bocamina.jpeg";
import personal from "../assets/personal-minero-nivel0.jpg";
import cobre from "../assets/lipena-cobre.jpg";
---

<MainLayout
  title="Minera Marte S.R.L. | Gold, Copper and Silver Mining in Bolivia"
  description="Private Bolivian mining company focused on gold, copper and silver exploration, responsible mining and technical development in Potosi and Sud Lipez, Bolivia."
  canonicalPath="/"
>
  <PublicShell>
    <main>
      <section class="hero">
        <img src={campamento.src} alt="Minera Marte mining camp in Sud Lipez, Potosi, Bolivia" />
        <div class="container hero-content">
          <p class="eyebrow">Private Bolivian Mining Company - Sud Lipez, Potosi</p>
          <h1>Gold, Copper and Silver Exploration in Bolivia</h1>
          <p class="hero-copy">
            Empresa Minera Marte S.R.L. develops responsible mining exploration with a technical
            focus on non-ferrous metallic resources in the Lipez region of Potosi, Bolivia.
          </p>
          <div class="hero-actions">
            <a class="button gold" href="/solicitar-acceso-data-room">Request Data Room Access</a>
            <a class="button ghost" href="/login" rel="nofollow">Log In to Data Room</a>
          </div>
          <div class="stats" aria-label="Company highlights">
            <div class="stat"><strong>Sud Lipez</strong><span>Project region</span></div>
            <div class="stat"><strong>Cu + Au + Ag</strong><span>Strategic metals</span></div>
            <div class="stat"><strong>Potosi</strong><span>Bolivia mining district</span></div>
            <div class="stat"><strong>Private</strong><span>Bolivian capital</span></div>
          </div>
        </div>
      </section>

      <section class="section" id="about">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Corporate Overview</p>
            <h2>Technical exploration with regional commitment.</h2>
            <p>
              Minera Marte combines geological work, operational discipline and responsible
              stewardship to evaluate copper, gold and silver potential in southern Bolivia.
            </p>
          </div>
          <div class="grid three">
            <article class="card">
              <h3>Mining Exploration</h3>
              <p>Field programs, sampling controls and geological interpretation for mineralized systems.</p>
            </article>
            <article class="card">
              <h3>Responsible Development</h3>
              <p>Safety, environmental care and community respect as operating principles.</p>
            </article>
            <article class="card">
              <h3>Investment Readiness</h3>
              <p>Structured technical information available through controlled Data Room access.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section soft" id="operations">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Operations</p>
            <h2>Exploration areas in Potosi and Sud Lipez.</h2>
          </div>
          <div class="grid three">
            <article class="media-card">
              <img src={bocamina.src} alt="Mining access at Minera Marte Bolivia" />
              <div><h3>Underground Access</h3><p>Operational work areas connected to geological review.</p></div>
            </article>
            <article class="media-card">
              <img src={personal.src} alt="Minera Marte mining personnel in Bolivia" />
              <div><h3>Technical Teams</h3><p>Local operating knowledge and field execution capacity.</p></div>
            </article>
            <article class="media-card">
              <img src={cobre.src} alt="Copper mineralization from Lipez Bolivia" />
              <div><h3>Mineral Focus</h3><p>Copper, gold and silver targets in a historic mining country.</p></div>
            </article>
          </div>
        </div>
      </section>

      <section class="section dark">
        <div class="container grid two">
          <div class="section-head">
            <p class="eyebrow">Data Room</p>
            <h2>Controlled access for technical review.</h2>
            <p>
              Investors and authorized visitors can request temporary credentials to review selected
              exploration information under administrative approval.
            </p>
          </div>
          <div class="card">
            <h3>Request Access</h3>
            <p>Submit contact details, company information and review purpose. Approved access is temporary and device-limited.</p>
            <p><a class="button gold" href="/solicitar-acceso-data-room">Open request form</a></p>
          </div>
        </div>
      </section>

      <section class="section" id="contact">
        <div class="container grid two">
          <div>
            <p class="eyebrow">Contact</p>
            <h2>Corporate Contact</h2>
          </div>
          <div class="card">
            <p><strong>Email:</strong> contact@minmartesrl.com</p>
            <p><strong>Project region:</strong> Sud Lipez, Potosi, Bolivia</p>
          </div>
        </div>
      </section>
    </main>
  </PublicShell>
</MainLayout>
